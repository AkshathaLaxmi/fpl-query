# Local development. Copy to .env only if you want to override the defaults;
# `fplq bootstrap` will generate credentials into .env for you on first run.
#
# NO PASSWORDS ARE COMMITTED. In deployment these come from Secrets Manager.

# The default below is a Linux socket path. On macOS (Homebrew or
# Postgres.app) the socket is in /tmp and the superuser is your own account,
# so use the second line instead -- with your username written out, since
# this file is read as literal key=value pairs and does not expand $(whoami).
# For Docker or any TCP server, use the third.
FPLQ_ADMIN_DSN=postgresql://postgres@/postgres?host=/var/run/postgresql
# FPLQ_ADMIN_DSN=postgresql://your-username@/postgres?host=/tmp
# FPLQ_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/postgres
FPLQ_DATABASE=fplq
FPLQ_RAW_STORE=./data/raw

# Generated by `fplq bootstrap` if absent:
# FPLQ_WRITER_PASSWORD=
# FPLQ_READER_PASSWORD=
# FPLQ_WRITER_DSN=
# FPLQ_READER_DSN=
